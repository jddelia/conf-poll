# ============================================
# Confluence Configuration
# ============================================

# Your Atlassian domain (e.g., https://yourcompany.atlassian.net)
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net

# Your Atlassian account email
CONFLUENCE_EMAIL=your-email@example.com

# API Token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
CONFLUENCE_API_TOKEN=your-api-token-here

# The page ID to monitor (find in page URL: /pages/123456789/Page-Title)
CONFLUENCE_PAGE_ID=123456789

# ============================================
# Polling Configuration
# ============================================

# Polling interval in milliseconds (default: 300000 = 5 minutes)
# Minimum recommended: 60000 (1 minute) to respect rate limits
POLL_INTERVAL_MS=300000

# Maximum consecutive errors before pausing (default: 5)
MAX_CONSECUTIVE_ERRORS=5

# Pause duration after max errors in milliseconds (default: 900000 = 15 minutes)
ERROR_PAUSE_DURATION_MS=900000

# ============================================
# Storage Configuration
# ============================================

# Database file path (default: ./data/conf-poll.db)
DATABASE_PATH=./data/conf-poll.db

# Maximum change history entries to keep (default: 1000)
MAX_HISTORY_ENTRIES=1000

# ============================================
# Logging Configuration
# ============================================

# Log level: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL=info

# Log to file (default: true)
LOG_TO_FILE=true

# Log file path (default: ./logs/conf-poll.log)
LOG_FILE_PATH=./logs/conf-poll.log

# Pretty print logs in console (default: true, set false for JSON logs)
LOG_PRETTY=true

# ============================================
# Notification Configuration (Optional)
# ============================================

# Enable desktop notifications (default: false)
ENABLE_DESKTOP_NOTIFICATIONS=false

# Slack webhook URL for notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Discord webhook URL for notifications (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY

# ============================================
# Table Parsing Configuration
# ============================================

# Index of the table to monitor (0-based, default: 0 for first table)
TARGET_TABLE_INDEX=0

# Columns to monitor (comma-separated, empty = all columns)
# Example: MONITOR_COLUMNS=0,1,3 (monitors 1st, 2nd, and 4th columns)
MONITOR_COLUMNS=

# Ignore header row changes (default: false)
IGNORE_HEADER_CHANGES=false

# ============================================
# Webhook Configuration (Optional)
# Post row changes to an external endpoint
# ============================================

# Enable webhook posting (default: false)
# When enabled, changed rows will be posted to the endpoint URL
WEBHOOK_ENABLED=false

# Endpoint URL to post changes to (required if WEBHOOK_ENABLED=true)
# The endpoint should accept POST requests with body: { "input": "<row data>" }
# WEBHOOK_ENDPOINT_URL=https://your-api.example.com/webhook

# Request timeout in milliseconds (default: 10000 = 10 seconds)
WEBHOOK_TIMEOUT_MS=10000

# Maximum retry attempts for failed requests (default: 3)
WEBHOOK_MAX_RETRIES=3

# Delay between retries in milliseconds (default: 1000 = 1 second)
WEBHOOK_RETRY_DELAY_MS=1000

# Include metadata (page title, version, timestamp) in webhook payload (default: true)
WEBHOOK_INCLUDE_METADATA=true
