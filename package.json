{
  "name": "conf-poll",
  "version": "1.0.0",
  "description": "Production-grade Confluence page polling and change detection system",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "conf-poll": "./src/cli/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test src/**/*.test.js",
    "test:watch": "node --test --watch src/**/*.test.js",
    "lint": "eslint src/",
    "validate": "node src/cli/validate.js"
  },
  "keywords": [
    "confluence",
    "polling",
    "change-detection",
    "atlassian",
    "monitoring"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "axios-retry": "^4.0.0",
    "sql.js": "^1.9.0",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.1.0",
    "deep-diff": "^1.0.2",
    "dotenv": "^16.3.1",
    "pino": "^8.17.1",
    "pino-pretty": "^10.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "eslint": "^8.55.0"
  }
}
